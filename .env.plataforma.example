# Copia este archivo como .env.plataforma y rellénalo. NO lo subas al repositorio.

# Clave maestra: firma las sesiones y cifra documentos y borradores.
# Genera una con:  python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
# Si se pierde, los documentos cifrados no se pueden recuperar.
RENTHOME_SECRET_KEY=

# 1 cuando se sirve por HTTPS (Cloudflare); 0 solo para pruebas por http://
RENTHOME_COOKIE_SECURE=1
# Dirección pública, usada en los enlaces de invitación
RENTHOME_BASE_URL=https://renthome.example.com

# Responsable del tratamiento (aparece en la política de privacidad)
RENTHOME_CONTROLLER_NAME=
RENTHOME_CONTROLLER_EMAIL=

# Modelo de IA local (servidor compatible con la API de OpenAI, p. ej. llama-server).
# Déjalo vacío para desactivar la capa de IA.
RENTHOME_LLM_URL=http://100.109.70.110:8082/v1
RENTHOME_LLM_MODEL=qwen3.8-27b

# Avisos por email de pisos nuevos en las búsquedas guardadas (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

TZ=Europe/Madrid

# Envío temporal de resultados por WhatsApp (solo administradores). URL del whatsapp-bridge
# en la red Docker y su token (store/.bridge-token). Déjalo vacío para desactivarlo.
RENTHOME_WHATSAPP_URL=
RENTHOME_WHATSAPP_TOKEN=

# Búsqueda web de inmobiliarias para el descubrimiento (API oficial de Brave Search, plan gratuito:
# https://brave.com/search/api/). Sin clave solo se usa OpenStreetMap.
RENTHOME_BRAVE_API_KEY=
