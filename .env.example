# Copia este archivo como .env y ajusta lo que quieras

# Zona horaria y cuándo buscar (día: mon tue wed thu fri sat sun / lun mar mie jue vie sab dom)
TZ=Europe/Madrid
RENTHOME_SCHEDULE=mon 08:47
# Minutos mínimos entre búsquedas manuales con el botón "Buscar ahora"
RENTHOME_COOLDOWN_MIN=30

# Dirección pública (se usa en los avisos para abrir la web al pulsar la notificación)
PUBLIC_URL=https://pisos.tudominio.com

# Avisos al móvil con ntfy (app gratuita "ntfy" en Android/iOS). Inventa un nombre difícil de adivinar.
NTFY_URL=https://ntfy.sh/pisos-ibiza-cambia-esto-x7k2
# NTFY_TOKEN=

# (Opcional) Email por Gmail con contraseña de aplicación
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASSWORD=
# MAIL_TO=tu@gmail.com

# (Opcional) Solo si usas el servicio cloudflared de docker-compose (--profile tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=
